# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Generated build info
backend/buildinfo/generated.json

# Code coverage
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.local
.env.*.local

# Build output. Wails v3's build definitions and platform metadata are source;
# only generated products under these paths are ignored.
bin/
build/coverage/
build/linux/appimage/build/
build/linux/*.desktop
dist/
app.syso

# do not ignore scripts/build directory
!scripts/build/

# Frontend dependencies and build
**/node_modules/
frontend/dist/
frontend/coverage/
*.js.map
*.css.map
package.json.md5

# Wails specific
wails.json.bak
*.wails

# Editor/IDE
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log

# Temporary and cache files
*.tmp
*.temp
.cache/
.task/
.parcel-cache/
.gocache/

# Debug and profiling
debug.log
*.pprof
*.prof

.claude/impact-analysis.md
.claude/settings.local.json
.agents/memory/

# playwright
.playwright-mcp/
