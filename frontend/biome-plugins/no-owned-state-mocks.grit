fresh|@/ui/shortcuts|@/ui/dockable|@core/refresh|@ui/shortcuts|@ui/dockable)(?:/index)?(?:\.tsx?)?['\"]$|^['\"]\.\.?/(?:[^'\"]*/)?(?:useNamespaceGridTablePersistence|useQueryBackedResourceGridTable|ClusterTabTransferCoordinator|useHydratedCustomCatalogRows|containerLogsStreamManager|useAutoRefreshLoadingState|WorkspacePanelCoordinator|gridTablePersistenceReset|useGridTableExternalFocus|useNodeMaintenanceActions|useObjectActionController|clusterAllowedNamespaces|usePanelMetricsCollector|ClusterLifecycleContext|ObjectPanelStateContext|clusterAttentionIgnores|panelLayoutStoreContext|useGridTablePersistence|PanelWindowRoleContext|gridTablePersistenceGC|objectPanelTabRequests|searchShortcutRegistry|useMetricsAvailability|useNamespaceColumnLink|resourceStreamManager|useCatalogDiagnostics|useDockablePanelState|useTypedResourceQuery|gridTablePersistence|panelLifecycleGuards|useMetricsBannerInfo|useResourceGridTable|SidebarStateContext|dockablePanelLayout|domainRegistrations|useClusterWorkspace|KubernetesProvider|NsResourcesContext|WorkspacePanelSync|navigateToFavorite|objectActionClient|useUtilizationData|KubeconfigContext|ModalStateContext|shortcuts/context|useNavigateToView|AuthErrorContext|FavoritesContext|NamespaceContext|ViewStateContext|app-state-access|read-diagnostics|resource-metrics|useBrowseCatalog|clusterTabOrder|dragCoordinator|permissionStore|shortcuts/hooks|appPreferences|namespaceScope|permissionRead|useObjectPanel|panel-windows|refresh/store|tabGroupState|capabilities|orchestrator|data-access|nodeLogsApi|dataAccess|favorites|shortcuts|dockable|refresh)(?:/index)?(?:\.tsx?)?['\"]$",
  register_diagnostic(
    span = $call,
    message = "Mount the real state owner with installAppStateHarness (test-utils/appState) instead of mocking it.",
    severity = "error"
  )
}
