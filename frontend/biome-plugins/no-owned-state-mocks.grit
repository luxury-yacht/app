engine biome(1.0)
language js(typescript, jsx)

// Tests mount the app's real state owners through the app-state harness
// (frontend/src/test-utils/appState/harness.tsx) instead of replacing them with
// stubs; a stub hides the wiring it replaces. Only the external boundary
// (@wailsio/runtime, @core/backend-api, @core/desktop-runtime, the refresh HTTP
// client) may be mocked. The pattern below is the owner list: state owners and the
// thin clients that read through them (docs/workflows/testing.md). Relative
// specifiers match by a distinctive file name; generic names (./index, ../store)
// are not covered.
or {
  `vi.mock($spec, $...)`,
  `vi.doMock($spec, $...)`
} as $call where {
  $spec <: r"^['\"](?:@/modules/object-panel/components/ObjectPanel/Metrics/usePanelMetricsCollector|@modules/object-panel/components/ObjectPanel/Metrics/usePanelMetricsCollector|@/modules/object-panel/components/ObjectPanel/Metrics/useUtilizationData|@modules/object-panel/components/ObjectPanel/Metrics/useUtilizationData|@/modules/object-panel/components/ObjectPanel/NodeLogs/nodeLogsApi|@modules/object-panel/components/ObjectPanel/NodeLogs/nodeLogsApi|@/shared/components/tables/persistence/gridTablePersistenceReset|@shared/components/tables/persistence/gridTablePersistenceReset|@/shared/components/tables/persistence/useGridTablePersistence|@/shared/components/tables/persistence/gridTablePersistenceGC|@shared/components/tables/persistence/useGridTablePersistence|@shared/components/tables/persistence/gridTablePersistenceGC|@/shared/components/tables/persistence/gridTablePersistence|@/modules/namespace/hooks/useNamespaceGridTablePersistence|@/shared/components/tables/hooks/useGridTableExternalFocus|@shared/components/tables/persistence/gridTablePersistence|@modules/namespace/hooks/useNamespaceGridTablePersistence|@shared/components/tables/hooks/useGridTableExternalFocus|@/modules/object-panel/contexts/ObjectPanelStateContext|@/modules/resource-grid/useQueryBackedResourceGridTable|@modules/object-panel/contexts/ObjectPanelStateContext|@modules/resource-grid/useQueryBackedResourceGridTable|@/modules/namespace/components/useNamespaceColumnLink|@modules/namespace/components/useNamespaceColumnLink|@/core/refresh/streaming/containerLogsStreamManager|@/modules/browse/hooks/useHydratedCustomCatalogRows|@/core/panel-windows/ClusterTabTransferCoordinator|@core/refresh/streaming/containerLogsStreamManager|@modules/browse/hooks/useHydratedCustomCatalogRows|@core/panel-windows/ClusterTabTransferCoordinator|@/core/refresh/diagnostics/useCatalogDiagnostics|@/core/refresh/hooks/useAutoRefreshLoadingState|@/modules/namespace/contexts/NsResourcesContext|@core/refresh/diagnostics/useCat