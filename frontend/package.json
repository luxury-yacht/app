{
  "name": "luxury-yacht-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26.8.1",
    "npm": ">=12.0.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check . && npm run check:error-reporting-boundaries && npm run check:biome-suppressions",
    "check:fix": "biome check --write . && npm run check:error-reporting-boundaries && npm run check:biome-suppressions",
    "check:error-reporting-boundaries": "node scripts/check-error-reporting-boundaries.mjs",
    "check:biome-suppressions": "node scripts/check-biome-suppressions.mjs",
    "sonar:audit": "node scripts/check-typescript-s3776.mjs",
    "sonar:audit:main": "node scripts/check-typescript-s3776.mjs --branch main",
    "sonar:baseline:update": "node scripts/check-typescript-s3776.mjs --branch main --update-baseline",
    "test": "vitest run",
    "knip": "knip",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "@antv/g": "^6.3.1",
    "@antv/g6": "^5.1.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@sentry/react": "^10.73.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@wailsio/runtime": "3.0.0-beta.16",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@sentry/vite-plugin": "^5.4.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
