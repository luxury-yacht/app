{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // This extends the root so editors opened at the repository root apply these settings.
  "root": false,
  "extends": "//",
  // Resolve ignore rules from the repository-level Git configuration, not only the frontend folder.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "root": "..",
    "useIgnoreFile": true
  },
  // Check every Biome-supported language maintained in this frontend. Build output, generated Wails
  // bindings, and npm's lockfile have separate owners and must not be rewritten by Biome.
  "files": {
    "includes": [
      "**/*.{js,jsx,ts,tsx,mjs,cjs,css,json,jsonc,html}",
      "!!dist",
      "!!coverage",
      "!!bindings",
      "!!package-lock.json"
    ]
  },
  // Go-rendered contracts are deliberately excluded from every Biome writer. All maintained
  // frontend files share one deterministic formatting contract.
  "formatter": {
    "enabled": true,
    "includes": [
      "**",
      "!src/core/refresh/types.generated.ts",
      "!src/shared/actions/objectActions.generated.ts"
    ],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  // Recommended assists include source actions such as import organization. They follow the same
  // generated-file boundary as the formatter.
  "assist": {
    "enabled": true,
    "includes": [
      "**",
      "!src/core/refresh/types.generated.ts",
      "!src/shared/actions/objectActions.generated.ts"
    ],
    "actions": {
      "preset": "recommended"
    }
  },
  // `recommended` supplies Biome's stable baseline. The groups below record audited strict rules
  // explicitly, including additional rules beyond that preset.
  "linter": {
    "enabled": true,
    "includes": [
      "**",
      "!src/core/refresh/types.generated.ts",
      "!src/shared/actions/objectActions.generated.ts"
    ],
    "rules": {
      "preset": "recommended",
      // Interactive UI must expose equivalent semantics to pointer, keyboard, and assistive
      // technology users. Prefer native elements before adding ARIA roles to generic elements.
      "a11y": {
        "noAutofocus": "error",
        "noLabelWithoutControl": "error",
        "noNoninteractiveElementInteractions": "error",
        "noNoninteractiveTabindex": "error",
        "noStaticElementInteractions": "error",
        "useAriaPropsForRole": "error",
        "useAriaPropsSupportedByRole": "error",
        "useFocusableInteractive": "error",
        "useKeyWithClickEvents": "error",
        "useSemanticElements": "error",
        "useValidAnchor": "error"
      },
      // Reject constructs that obscure control flow or make APIs and CSS harder to maintain.
      "complexity": {
        "noImportantStyles": "error",
        "noStaticOnlyClass": "error",
        "useMaxParams": {
          "level": "error",
          "options": {
            // Above seven parameters, group cohesive inputs into a named object.
            "max": 7
          }
        }
      },
      // Treat unresolved modules, incomplete React dependencies, unstable IDs, and other likely
      // runtime defects as build failures.
      "correctness": {
        "noUnresolvedImports": "error",
        "noUnusedInstantiation": "error",
        "useImageSize": "error",
        "useUniqueElementIds": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            // Dependency arrays must omit values that cannot affect the hook result, not merely
            // include every value mentioned near the callback.
            "reportUnnecessaryDependencies": true
          }
        }
      },
      // Prefer reconstruction or Map/Set operations over deleting object properties, which also
      // keeps state transitions explicit.
      "performance": {
        "noDelete": "error"
      },
      // Promote ambiguous, error-prone, or misleading JavaScript patterns beyond the recommended
      // preset so they cannot accumulate behind warnings.
      "suspicious": {
        "noArrayIndexKey": "error",
        "noConfusingVoidType": "error",
        "noConsole": {
          "level": "error",
          "options": {
            // Keep operational diagnostics, assertions, and structured groups available while
            // rejecting casual console.log/debug output.
            "allow": ["assert", "error", "group", "groupCollapsed", "groupEnd", "info", "warn"]
          }
        },
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error",
        "noEvolvingTypes": "error",
        "noEqualsToNull": "error",
        "noForIn": "error",
        "noImportCycles": "error",
        "noLeakedRender": "error",
        "noMisplacedAssertion": "error",
        "noNestedPromises": "error",
        "noPrototypeBuiltins": "error",
        "noReactForwardRef": "error",
        "noReturnAssign": "error",
        "noShadow": "error",
        "noSkippedTests": "error",
        "noUnusedExpressions": "error",
        "useGuardForIn": "error",
        "useStrictMode": "error",
        "useIterableCallbackReturn": {
          "level": "error",
          "options": {
            // Also catch accidental return values and inconsistent returns in forEach callbacks.
            "checkForEach": true
          }
        }
      },
      // Keep TypeScript and CSS conventions explicit and predictable across the frontend.
      "style": {
        "noDescendingSpecificity": "error",
        "noEnum": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            // Both the configured alias and relative-path variants must cross the maintained
            // backend API facade instead of binding application code to generated Wails modules.
            "paths": {
              "@bindings/github.com/luxury-yacht/app/backend/desktopservice": "Import generated backend bindings only through @/core/backend-api.",
              "@sentry/react": "Import Sentry only through @/core/telemetry/sentry so consent, redaction, and breadcrumb policy cannot be bypassed."
            },
            "patterns": [
              {
                "group": ["**/bindings/github.com/luxury-yacht/app/backend/desktopservice"],
                "message": "Import generated backend bindings only through @/core/backend-api."
              }
            ]
          }
        },
        "noUnusedTemplateLiteral": "error",
        "useBlockStatements": "error",
        "useConsistentObjectDefinitions": "error"
      }
    }
  },
  // These choices match the established TypeScript and JSX conventions used throughout the app.
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  // Full HTML support lets Biome format and lint index.html with the rest of the frontend.
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "plugins": [
    // These plugins keep feature code behind the shared data-access boundaries.
    {
      // Network reads belong to refresh or data-access infrastructure.
      "path": "./biome-plugins/no-direct-fetch.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/core/refresh/**", "!**/src/core/data-access/**"]
    },
    {
      // Permission queries must be routed through the shared data-access reader.
      "path": "./biome-plugins/no-direct-permission-read.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/core/data-access/readers.ts"]
    },
    {
      // One store owns the combined workspace RPC and cluster-state subscriptions.
      "path": "./biome-plugins/no-direct-cluster-workspace.grit",
      "includes": [
        "**/src/**/*.{ts,tsx}",
        "!**/src/**/*.test.*",
        "!**/src/core/cluster-workspace/**"
      ]
    },
    {
      // Feature code must not couple directly to low-level refresh orchestration commands.
      "path": "./biome-plugins/no-direct-refresh-orchestrator.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/core/refresh/**", "!**/src/core/data-access/**"]
    },
    {
      // Clipboard writes use the native desktop clipboard; the WebView refuses click-started browser writes.
      "path": "./biome-plugins/no-direct-clipboard-write.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/**/*.test.*", "!**/src/**/*.stories.*"]
    },
    {
      // Clipboard reads use the native desktop clipboard; the WebView gates browser reads behind a Paste callout.
      "path": "./biome-plugins/no-direct-clipboard-read.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/**/*.test.*", "!**/src/**/*.stories.*"]
    },
    {
      // Caught operational failures cross one boundary so the original exception is reportable.
      "path": "./biome-plugins/no-direct-console-error.grit",
      "includes": [
        "**/src/**/*.{ts,tsx}",
        "!**/src/**/*.test.*",
        "!**/src/utils/errorHandler.ts",
        "!**/src/core/telemetry/sentry.ts"
      ]
    },
    {
      // Dynamic error text must be classified by the shared UI presentation boundary.
      "path": "./biome-plugins/no-inline-error-text.grit",
      "includes": [
        "**/src/**/*.tsx",
        "!**/src/**/*.test.*",
        "!**/src/**/*.stories.*",
        "!**/src/shared/components/errors/**",
        "!**/src/ui/errors/**"
      ]
    },
    {
      // Tests mount real state owners through test-utils/appState instead of stubbing them.
      // Baseline: suites not yet migrated (docs/plans/real-state-test-harness.md). Each
      // migration phase deletes its suites' lines; never add a line.
      "path": "./biome-plugins/no-owned-state-mocks.grit",
      "includes": [
        "**/src/**/*.test.{ts,tsx}",
        "!**/src/App.menu.test.tsx",
        "!**/src/core/capabilities/hooks.test.tsx",
        "!**/src/core/capabilities/permissionStore.test.ts",
        "!**/src/core/contexts/ClusterLifecycleContext.test.tsx",
        "!**/src/core/contexts/FavoritesContext.test.tsx",
        "!**/src/core/contexts/SidebarStateContext.test.tsx",
        "!**/src/core/contexts/ViewStateContext.telemetry.test.tsx",
        "!**/src/core/contexts/ZoomContext.test.tsx",
        "!**/src/core/data-access/dataAccess.test.ts",
        "!**/src/core/data-access/useScopedRefreshDomainLifecycle.test.tsx",
        "!**/src/core/navigation/useAvailableResourceViews.test.tsx",
        "!**/src/core/refresh/components/DiagnosticsPanel.test.ts",
        "!**/src/core/refresh/domainContract.test.ts",
        "!**/src/core/refresh/hooks/useMetricsAvailability.test.tsx",
        "!**/src/core/refresh/orchestrator.streamingFlap.test.ts",
        "!**/src/core/refresh/orchestrator.test.ts",
        "!**/src/hooks/multiClusterIsolation.test.ts",
        "!**/src/main.test.ts",
        "!**/src/modules/browse/components/BrowseView.test.tsx",
        "!**/src/modules/browse/hooks/catalogFreshness.integration.test.tsx",
        "!**/src/modules/browse/hooks/useBrowseCatalog.test.tsx",
        "!**/src/modules/browse/hooks/useBrowseColumns.test.tsx",
        "!**/src/modules/browse/hooks/useHydratedCustomCatalogRows.test.tsx",
        "!**/src/modules/cluster/components/ClusterOverview.test.tsx",
        "!**/src/modules/cluster/components/ClusterResourcesManager.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewAttention.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewCRDs.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewConfig.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewCustom.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewEvents.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewIdentities.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewNamespaces.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewNodes.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewNodesRevisit.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewRBAC.test.tsx",
        "!**/src/modules/cluster/components/ClusterViewStorage.test.tsx",
        "!**/src/modules/cluster/components/clusterCustomFilterPropagation.test.tsx",
        "!**/src/modules/global/components/GlobalViewClusters.test.tsx",
        "!**/src/modules/global/components/GlobalViewNamespaces.test.tsx",
        "!**/src/modules/kubernetes/config/KubeconfigContext.test.tsx",
        "!**/src/modules/namespace/components/NsViewAutoscaling.test.tsx",
        "!**/src/modules/namespace/components/NsViewConfig.test.tsx",
        "!**/src/modules/namespace/components/NsViewCustom.test.tsx",
        "!**/src/modules/namespace/components/NsViewEvents.test.tsx",
        "!**/src/modules/namespace/components/NsViewHelm.test.tsx",
        "!**/src/modules/namespace/components/NsViewMap.test.tsx",
        "!**/src/modules/namespace/components/NsViewNetwork.test.tsx",
        "!**/src/modules/namespace/components/NsViewPods.test.tsx",
        "!**/src/modules/namespace/components/NsViewQuotas.test.tsx",
        "!**/src/modules/namespace/components/NsViewRBAC.test.tsx",
        "!**/src/modules/namespace/components/NsViewStorage.test.tsx",
        "!**/src/modules/namespace/components/NsViewWorkloads.test.tsx",
        "!**/src/modules/namespace/components/useNamespaceColumnLink.test.tsx",
        "!**/src/modules/namespace/components/useWorkloadTableColumns.test.tsx",
        "!**/src/modules/namespace/contexts/NamespaceContext.test.tsx",
        "!**/src/modules/namespace/contexts/NsResourcesContext.test.tsx",
        "!**/src/modules/namespace/hooks/useNamespaceGridTablePersistence.test.tsx",
        "!**/src/modules/object-map/ObjectMap.test.tsx",
        "!**/src/modules/object-panel/components/ObjectPanel/Logs/LogViewer.benchmark.test.tsx",
        "!**/src/modules/resource-grid/queryBackedLeafFirstLoad.test.tsx",
        "!**/src/modules/resource-grid/useAnchorOnUnmatchedFocusRequest.test.tsx",
        "!**/src/modules/resource-grid/useQueryBackedResourceGridTable.test.tsx",
        "!**/src/modules/resource-grid/useResourceGridTable.test.tsx",
        "!**/src/modules/resource-grid/useTypedResourceQuery.anchor.test.tsx",
        "!**/src/modules/resource-grid/useTypedResourceQuery.test.tsx",
        "!**/src/shared/components/ObjectPanelLink.test.tsx",
        "!**/src/shared/components/ResourceLoadingBoundary.test.tsx",
        "!**/src/shared/components/kubernetes/ActionsMenu.integration.test.tsx",
        "!**/src/shared/components/kubernetes/ActionsMenu.test.tsx",
        "!**/src/shared/components/kubernetes/ResourceHeader.test.tsx",
        "!**/src/shared/components/modals/DrainNodeModal.test.tsx",
        "!**/src/shared/components/tables/GridTable.rowDetail.test.tsx",
        "!**/src/shared/components/tables/GridTable.test.tsx",
        "!**/src/shared/components/tables/GridTableFiltersBar.test.tsx",
        "!**/src/shared/components/tables/GridTableKeys.test.tsx",
        "!**/src/shared/components/tables/hooks/useGridTableDownloadAction.test.tsx",
        "!**/src/shared/components/tables/hooks/useGridTableHeaderContextMenu.test.tsx",
        "!**/src/shared/components/tables/hooks/useGridTableShortcuts.test.tsx",
        "!**/src/shared/components/tables/persistence/useGridTablePersistence.multicluster.test.tsx",
        "!**/src/shared/components/tables/persistence/useGridTablePersistence.test.tsx",
        "!**/src/shared/components/yaml/YamlEditor.test.tsx",
        "!**/src/shared/hooks/useNavigateToView.test.tsx",
        "!**/src/shared/hooks/useNodeMaintenanceActions.lifecycle.test.tsx",
        "!**/src/shared/hooks/useObjectLink.test.tsx",
        "!**/src/ui/command-palette/CommandPalette.keyboard.test.tsx",
        "!**/src/ui/command-palette/CommandPalette.test.tsx",
        "!**/src/ui/command-palette/CommandPaletteCommands.test.tsx",
        "!**/src/ui/favorites/FavMenuDropdown.test.tsx",
        "!**/src/ui/favorites/FavSaveModal.test.tsx",
        "!**/src/ui/favorites/FavToggle.test.tsx",
        "!**/src/ui/layout/ClusterTabs.test.tsx",
        "!**/src/ui/layout/NamespaceScopeEditor.test.tsx",
        "!**/src/ui/layout/Sidebar.navigation.test.tsx",
        "!**/src/ui/layout/Sidebar.test.tsx",
        "!**/src/ui/layout/appFocusRegions.test.tsx",
        "!**/src/ui/layout/namespaceScope.test.ts",
        "!**/src/ui/modals/ObjectDiffModal.test.tsx",
        "!**/src/ui/modals/SettingsModal.test.tsx",
        "!**/src/ui/modals/useObjectDiffYaml.test.tsx",
        "!**/src/ui/overlays/AuthFailureOverlay.integration.test.tsx",
        "!**/src/ui/panels/app-logs/AppLogsPanel.test.tsx",
        "!**/src/ui/settings/sections/AdvancedSection.test.tsx",
        "!**/src/ui/settings/sections/AppearanceSection.test.tsx",
        "!**/src/ui/settings/sections/DataManagementSection.test.tsx",
        "!**/src/ui/settings/sections/DisplaySection.test.tsx",
        "!**/src/ui/settings/sections/LogsSection.test.tsx",
        "!**/src/ui/settings/sections/ObjectPanelSection.test.tsx",
        "!**/src/ui/settings/sections/preferenceConcurrency.test.tsx",
        "!**/src/ui/shortcuts/components/GlobalShortcuts.test.tsx",
        "!**/src/ui/shortcuts/components/PanelWindowShortcuts.test.tsx",
        "!**/src/ui/shortcuts/components/SearchShortcutHandler.test.tsx",
        "!**/src/ui/shortcuts/useSearchShortcutTarget.test.tsx",
        "!**/src/ui/status/ConnectivityStatus.test.tsx",
        "!**/src/ui/status/MetricsStatus.test.tsx",
        "!**/src/ui/status/SessionsStatus.test.tsx",
        "!**/src/ui/status/UpdateStatus.test.tsx",
        "!**/src/utils/appearanceMode.test.ts"
      ]
    }
  ],
  // Overrides are narrow architectural boundaries, not general escape hatches. Keep the reason for
  // every override next to its scope so config diffs remain self-explanatory.
  "overrides": [
    {
      // Browser production code must not depend on Node.js-only modules.
      "includes": ["src/**", "!src/**/*.test.*", "!src/**/*.stories.*"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      // Temporary: Biome 2.6 made this rule recommended, and existing test probes and harnesses are
      // defined inside test bodies and render helpers. The cleanup is tracked in docs/todo.md;
      // remove this override when it lands. Production code stays under the rule.
      "includes": ["src/**/*.test.*"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      // The backend API facade is the one boundary allowed to import generated Wails bindings.
      "includes": ["src/core/backend-api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@sentry/react": "Import Sentry only through @/core/telemetry/sentry so consent, redaction, and breadcrumb policy cannot be bypassed."
                }
              }
            }
          }
        }
      }
    },
    {
      // The telemetry module is the single Sentry SDK boundary. Every caller uses its typed,
      // privacy-reviewed operations rather than constructing events or breadcrumbs directly.
      "includes": ["src/core/telemetry/sentry.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
